<main id="site__main"
      class="relative 2xl:ml-[--w-side] xl:ml-[--w-side-sm] min-h-[calc(100vh-var(--m-top))] mt-[--m-top] px-4 py-8 sm:px-6">

    <div class="relative lg:flex 2xl:gap-12 gap-8 max-w-[1160px] mx-auto" id="js-oversized">

        <!-- ═══ Main feed ═══ -->
        <div class="max-w-[700px] w-full mx-auto lg:mx-0 space-y-5">

            <!-- ── Stories ── -->
            <div class="rounded-3xl bg-white/80 backdrop-blur-xl border border-white/70 shadow-xl shadow-indigo-100/30 px-5 py-5 overflow-hidden card-lift">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px;">
                    <div>
                        <div style="display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:3px 12px;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px;border:1px solid rgba(167,139,250,.3);background:linear-gradient(135deg,#f5f3ff,#ede9fe);color:#7c3aed;">
                            <ion-icon name="sparkles-outline" style="font-size:12px;"></ion-icon>
                            Fresh moments
                        </div>
                        <h3 style="font-size:20px;font-weight:800;color:#0f172a;letter-spacing:-.02em;margin:0;">Stories</h3>
                    </div>
                    <button type="button"
                            style="display:none;align-items:center;gap:6px;border-radius:12px;color:#fff;padding:8px 16px;font-size:13px;font-weight:800;border:none;cursor:pointer;background:linear-gradient(135deg,#6366f1,#8b5cf6,#7c3aed);box-shadow:0 6px 20px rgba(99,102,241,.35);"
                            class="sm:!flex"
                            uk-toggle="target: #create-story">
                        <ion-icon name="add-outline" style="font-size:16px;"></ion-icon>
                        Add Story
                    </button>
                </div>

                <div class="relative" tabindex="-1" uk-slider="autoplay: true; finite: true" uk-lightbox="">
                    <div class="uk-slider-container">
                        <ul class="uk-slider-items" style="width:calc(100% + 14px);"
                            uk-scrollspy="target: >li; cls: uk-animation-scale-up; delay: 20; repeat: true">

                            <!-- Add story -->
                            <li style="padding-right:12px;" uk-scrollspy-class="uk-animation-fade">
                                <button type="button"
                                        style="width:68px;height:68px;border-radius:14px;border:2px dashed #8b5cf6;display:flex;align-items:center;justify-content:center;font-size:26px;color:#8b5cf6;background:linear-gradient(135deg,#f5f3ff,#ede9fe);cursor:pointer;flex-shrink:0;transition:transform .2s ease;"
                                        onmouseenter="this.style.transform='scale(1.08)'" onmouseleave="this.style.transform='scale(1)'"
                                        uk-toggle="target: #create-story">
                                    <ion-icon name="add-circle-outline"></ion-icon>
                                </button>
                            </li>

                            <!-- Story 1 -->
                            <li style="padding-right:12px;">
                                <div style="width:68px;height:68px;border-radius:14px;padding:3px;flex-shrink:0;background:linear-gradient(135deg,#6366f1,#8b5cf6,#ec4899);box-shadow:0 4px 16px rgba(99,102,241,.3);transition:transform .2s ease;"
                                     onmouseenter="this.style.transform='scale(1.08)'" onmouseleave="this.style.transform='scale(1)'">
                                    <div style="width:100%;height:100%;border-radius:11px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.15);">
                                        <ion-icon name="person-circle-outline" style="font-size:34px;color:white;"></ion-icon>
                                    </div>
                                </div>
                            </li>

                            <!-- Story 2 -->
                            <li style="padding-right:12px;">
                                <div style="width:68px;height:68px;border-radius:14px;padding:3px;flex-shrink:0;background:linear-gradient(135deg,#f43f5e,#f97316,#fbbf24);box-shadow:0 4px 16px rgba(244,63,94,.3);transition:transform .2s ease;"
                                     onmouseenter="this.style.transform='scale(1.08)'" onmouseleave="this.style.transform='scale(1)'">
                                    <div style="width:100%;height:100%;border-radius:11px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.15);">
                                        <ion-icon name="person-circle-outline" style="font-size:34px;color:white;"></ion-icon>
                                    </div>
                                </div>
                            </li>

                            <!-- Skeletons -->
                            <li style="padding-right:12px;">
                                <div style="width:68px;height:68px;border-radius:14px;background:#f1f5f9;animation:pulse 2s cubic-bezier(.4,0,.6,1) infinite;"></div>
                            </li>
                            <li style="padding-right:12px;">
                                <div style="width:68px;height:68px;border-radius:14px;background:#f1f5f9;opacity:.6;animation:pulse 2s cubic-bezier(.4,0,.6,1) infinite;animation-delay:.15s;"></div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- ── Create post ── -->
            <div style="background:rgba(255,255,255,.85);backdrop-filter:blur(20px);border-radius:24px;border:1px solid rgba(255,255,255,.7);padding:16px;box-shadow:0 20px 60px rgba(99,102,241,.12);">

                <div style="display:flex;align-items:center;gap:10px;">
                    <!-- User avatar — INLINE SIZED, no img tag -->
                    <div style="width:44px;height:44px;min-width:44px;min-height:44px;border-radius:12px;padding:2.5px;flex-shrink:0;background:linear-gradient(135deg,#6366f1,#8b5cf6);box-shadow:0 4px 14px rgba(99,102,241,.28);">
                        <div style="width:100%;height:100%;border-radius:9px;overflow:hidden;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.15);">
                            <ion-icon name="person-circle-outline" style="font-size:28px;color:white;"></ion-icon>
                        </div>
                    </div>

                    <!-- Input -->
                    <button type="button"
                            style="flex:1;background:rgba(248,250,255,.8);border:1px solid rgba(203,213,225,.7);border-radius:12px;padding:10px 16px;font-size:13px;color:#94a3b8;text-align:left;cursor:pointer;font-weight:500;transition:all .2s;font-family:inherit;"
                            onmouseenter="this.style.borderColor='#c7d2fe';this.style.background='rgba(238,242,255,.6)'"
                            onmouseleave="this.style.borderColor='rgba(203,213,225,.7)';this.style.background='rgba(248,250,255,.8)'"
                            uk-toggle="target: #create-status">
                        What's on your mind? ✨
                    </button>

                    <!-- Photo btn -->
                    <button type="button"
                            style="width:44px;height:44px;min-width:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:20px;color:#f43f5e;border:1px solid rgba(253,205,213,.8);background:linear-gradient(135deg,#fff1f2,#ffe4e6);cursor:pointer;transition:transform .2s;"
                            onmouseenter="this.style.transform='scale(1.08)'" onmouseleave="this.style.transform='scale(1)'"
                            uk-toggle="target: #create-status">
                        <ion-icon name="image-outline"></ion-icon>
                    </button>
                </div>

                <!-- Action pills -->
                <div style="display:flex;align-items:center;gap:6px;margin-top:12px;padding-top:12px;border-top:1px solid rgba(241,245,249,.8);flex-wrap:wrap;">
                    <button uk-toggle="target: #create-status"
                            style="display:flex;align-items:center;gap:5px;padding:5px 10px;border-radius:9px;background:#f8fafc;border:1px solid transparent;font-size:11px;font-weight:700;color:#64748b;cursor:pointer;font-family:inherit;transition:all .15s;"
                            onmouseenter="this.style.background='#fff1f2';this.style.color='#f43f5e';this.style.borderColor='#fecdd3'"
                            onmouseleave="this.style.background='#f8fafc';this.style.color='#64748b';this.style.borderColor='transparent'">
                        <ion-icon name="image-outline" style="font-size:14px;color:#f43f5e;"></ion-icon> Photo
                    </button>
                    <button uk-toggle="target: #create-status"
                            style="display:flex;align-items:center;gap:5px;padding:5px 10px;border-radius:9px;background:#f8fafc;border:1px solid transparent;font-size:11px;font-weight:700;color:#64748b;cursor:pointer;font-family:inherit;transition:all .15s;"
                            onmouseenter="this.style.background='#f5f3ff';this.style.color='#8b5cf6';this.style.borderColor='#ddd6fe'"
                            onmouseleave="this.style.background='#f8fafc';this.style.color='#64748b';this.style.borderColor='transparent'">
                        <ion-icon name="videocam-outline" style="font-size:14px;color:#8b5cf6;"></ion-icon> Video
                    </button>
                    <button uk-toggle="target: #create-status"
                            style="display:flex;align-items:center;gap:5px;padding:5px 10px;border-radius:9px;background:#f8fafc;border:1px solid transparent;font-size:11px;font-weight:700;color:#64748b;cursor:pointer;font-family:inherit;transition:all .15s;"
                            onmouseenter="this.style.background='#fffbeb';this.style.color='#d97706';this.style.borderColor='#fde68a'"
                            onmouseleave="this.style.background='#f8fafc';this.style.color='#64748b';this.style.borderColor='transparent'">
                        <ion-icon name="happy-outline" style="font-size:14px;color:#f59e0b;"></ion-icon> Feeling
                    </button>
                    <button uk-toggle="target: #create-status"
                            style="display:flex;align-items:center;gap:5px;padding:5px 10px;border-radius:9px;background:#f8fafc;border:1px solid transparent;font-size:11px;font-weight:700;color:#64748b;cursor:pointer;font-family:inherit;transition:all .15s;"
                            onmouseenter="this.style.background='#f0fdf4';this.style.color='#059669';this.style.borderColor='#a7f3d0'"
                            onmouseleave="this.style.background='#f8fafc';this.style.color='#64748b';this.style.borderColor='transparent'">
                        <ion-icon name="location-outline" style="font-size:14px;color:#10b981;"></ion-icon> Check in
                    </button>
                </div>
            </div>

            <!-- ── Feed label ── -->
            <div style="display:flex;align-items:center;gap:10px;padding:0 4px;">
                <span style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:#94a3b8;white-space:nowrap;">Recent posts</span>
                <div style="flex:1;height:1px;background:linear-gradient(to right,#e2e8f0,transparent);"></div>
            </div>

            <!-- ── Empty state ── -->
            <div style="background:rgba(255,255,255,.75);backdrop-filter:blur(20px);border-radius:20px;border:1px solid rgba(255,255,255,.6);padding:16px 20px;display:flex;align-items:center;gap:14px;">
                <div style="width:44px;height:44px;min-width:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;color:#6366f1;border:1px solid rgba(99,102,241,.15);background:linear-gradient(135deg,#eef2ff,#ede9fe);">
                    <ion-icon name="newspaper-outline"></ion-icon>
                </div>
                <div>
                    <p style="font-size:14px;font-weight:800;color:#0f172a;margin:0;">Your feed is quiet</p>
                    <p style="font-size:12px;color:#94a3b8;margin:2px 0 0;">Follow people or create the first post!</p>
                </div>
                <button style="margin-left:auto;display:flex;align-items:center;gap:5px;padding:8px 16px;border-radius:12px;font-size:12px;font-weight:800;color:#fff;border:none;cursor:pointer;background:linear-gradient(135deg,#6366f1,#8b5cf6);box-shadow:0 4px 12px rgba(99,102,241,.3);font-family:inherit;">
                    Explore
                </button>
            </div>

            <!-- ── Post card (Marccoa Pop) ── -->
            <div style="background:rgba(255,255,255,.85);backdrop-filter:blur(20px);border-radius:24px;border:1px solid rgba(255,255,255,.7);overflow:hidden;box-shadow:0 20px 60px rgba(99,102,241,.1);">

                <!-- Post header -->
                <div style="display:flex;align-items:flex-start;gap:10px;padding:16px 16px 10px;">
                    <!-- Author avatar — inline sized -->
                    <a href="" style="flex-shrink:0;text-decoration:none;">
                        <div style="width:44px;height:44px;min-width:44px;min-height:44px;border-radius:12px;padding:2.5px;background:linear-gradient(135deg,#6366f1,#8b5cf6);box-shadow:0 4px 14px rgba(99,102,241,.28);">
                            <div style="width:100%;height:100%;border-radius:9px;overflow:hidden;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.15);">
                                <ion-icon name="person-circle-outline" style="font-size:28px;color:white;"></ion-icon>
                            </div>
                        </div>
                    </a>

                    <div style="flex:1;min-width:0;">
                        <h4 style="font-size:14px;font-weight:800;color:#0f172a;margin:0;line-height:1.3;">Marccoa Pop</h4>
                        <div style="display:flex;align-items:center;gap:5px;margin-top:3px;font-size:11px;color:#94a3b8;">
                            <ion-icon name="time-outline" style="font-size:11px;"></ion-icon>
                            1 day ago
                            <span style="color:#e2e8f0;">·</span>
                            <ion-icon name="earth-outline" style="font-size:11px;color:#6366f1;"></ion-icon>
                            <span style="color:#6366f1;font-weight:700;">Public</span>
                        </div>
                    </div>

                    <!-- 3-dot menu -->
                    <div class="relative" style="margin-right:-4px;">
                        <button type="button"
                                style="width:34px;height:34px;display:flex;align-items:center;justify-content:center;border-radius:10px;border:none;background:transparent;cursor:pointer;font-size:18px;color:#94a3b8;transition:all .2s;"
                                onmouseenter="this.style.background='#f1f5f9';this.style.color='#475569'"
                                onmouseleave="this.style.background='transparent';this.style.color='#94a3b8'">
                            <ion-icon name="ellipsis-horizontal"></ion-icon>
                        </button>
                        <div class="w-[240px] rounded-2xl bg-white/96 backdrop-blur-xl shadow-2xl border border-slate-100 p-2"
                             uk-dropdown="pos: bottom-right; animation: uk-animation-scale-up; animate-out: true; mode: click">
                            <form>
                                <button type="submit" class="icon-link w-full flex items-center gap-2.5 rounded-xl px-3 py-2.5 hover:!bg-red-50 hover:!text-red-600 text-slate-600 text-sm">
                                    <ion-icon class="text-base shrink-0" name="flag-outline"></ion-icon> Report post
                                </button>
                            </form>
                            <hr class="my-1 border-slate-100" />
                            <form>
                                <button type="submit" class="icon-link w-full flex items-center gap-2.5 rounded-xl px-3 py-2.5 hover:!bg-indigo-50 hover:!text-indigo-700 text-slate-600 text-sm">
                                    <ion-icon class="text-base shrink-0" name="lock-closed-outline"></ion-icon> Set as private
                                </button>
                            </form>
                            <hr class="my-1 border-slate-100" />
                            <form>
                                <button type="submit" class="icon-link w-full flex items-center gap-2.5 rounded-xl px-3 py-2.5 hover:!bg-red-50 text-red-500 text-sm">
                                    <ion-icon class="text-base shrink-0" name="trash-bin-outline"></ion-icon> Delete post
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Post text -->
                <div style="padding:0 16px 12px;font-size:13px;color:#475569;line-height:1.7;font-weight:400;">
                    This is our first post from <strong style="color:#6366f1;">#CampusConnect</strong> — share moments, text &amp; pictures with your campus friends! 🎉
                </div>

                <!-- Post image — CSS gradient placeholder, fixed height, zero dependency -->
                <div style="margin:0 16px 12px;border-radius:16px;overflow:hidden;height:260px;background:linear-gradient(135deg,#e0e7ff 0%,#ede9fe 45%,#dbeafe 100%);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;box-shadow:inset 0 2px 20px rgba(99,102,241,.07);">
                    <div style="width:64px;height:64px;border-radius:18px;background:rgba(255,255,255,.7);display:flex;align-items:center;justify-content:center;font-size:32px;color:#a5b4fc;box-shadow:0 4px 20px rgba(99,102,241,.15);">
                        <ion-icon name="image-outline"></ion-icon>
                    </div>
                    <span style="font-size:13px;font-weight:700;color:#818cf8;letter-spacing:.02em;">Campus moments</span>
                </div>

                <!-- Reaction count row -->
                <div style="padding:8px 16px;display:flex;align-items:center;gap:8px;font-size:11px;color:#64748b;border-top:1px solid rgba(241,245,249,.8);border-bottom:1px solid rgba(241,245,249,.8);">
                    <div style="display:flex;gap:-4px;">
                        <span style="width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.1);background:linear-gradient(135deg,#ef4444,#dc2626);">❤</span>
                        <span style="width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;border:2px solid #fff;margin-left:-4px;box-shadow:0 1px 4px rgba(0,0,0,.1);background:linear-gradient(135deg,#6366f1,#8b5cf6);">👍</span>
                    </div>
                    <span style="font-weight:700;color:#334155;">24</span>
                    <span style="margin-left:auto;cursor:pointer;">5 comments</span>
                </div>

                <!-- Action buttons -->
                <div style="display:flex;padding:4px 10px;border-bottom:1px solid rgba(241,245,249,.8);">
                    <button style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:9px;border-radius:10px;border:none;background:transparent;font-size:12px;font-weight:700;color:#64748b;cursor:pointer;font-family:inherit;transition:all .15s;"
                            onmouseenter="this.style.background='#fff1f2';this.style.color='#ef4444'"
                            onmouseleave="this.style.background='transparent';this.style.color='#64748b'">
                        <ion-icon name="heart-outline" style="font-size:17px;"></ion-icon> Like
                    </button>
                    <button style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:9px;border-radius:10px;border:none;background:transparent;font-size:12px;font-weight:700;color:#64748b;cursor:pointer;font-family:inherit;transition:all .15s;"
                            onmouseenter="this.style.background='#eef2ff';this.style.color='#6366f1'"
                            onmouseleave="this.style.background='transparent';this.style.color='#64748b'">
                        <ion-icon name="chatbubble-ellipses-outline" style="font-size:17px;"></ion-icon> Comment
                    </button>
                    <button style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:9px;border-radius:10px;border:none;background:transparent;font-size:12px;font-weight:700;color:#64748b;cursor:pointer;font-family:inherit;transition:all .15s;"
                            onmouseenter="this.style.background='#f5f3ff';this.style.color='#8b5cf6'"
                            onmouseleave="this.style.background='transparent';this.style.color='#64748b'">
                        <ion-icon name="share-social-outline" style="font-size:17px;"></ion-icon> Share
                    </button>
                    <button style="width:40px;display:flex;align-items:center;justify-content:center;padding:9px;border-radius:10px;border:none;background:transparent;font-size:17px;color:#94a3b8;cursor:pointer;transition:all .15s;"
                            onmouseenter="this.style.background='#fffbeb';this.style.color='#f59e0b'"
                            onmouseleave="this.style.background='transparent';this.style.color='#94a3b8'">
                        <ion-icon name="bookmark-outline"></ion-icon>
                    </button>
                </div>

                <!-- Comment input -->
                <div style="display:flex;align-items:center;gap:10px;padding:12px 16px;background:rgba(248,250,252,.5);">
                    <!-- Comment avatar -->
                    <div style="width:34px;height:34px;min-width:34px;border-radius:10px;padding:2px;flex-shrink:0;background:linear-gradient(135deg,#6366f1,#8b5cf6);">
                        <div style="width:100%;height:100%;border-radius:8px;overflow:hidden;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.15);">
                            <ion-icon name="person-circle-outline" style="font-size:20px;color:white;"></ion-icon>
                        </div>
                    </div>
                    <div style="flex:1;background:#fff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;transition:all .2s;"
                         onfocusin="this.style.borderColor='#a5b4fc';this.style.boxShadow='0 0 0 3px rgba(165,180,252,.2)'"
                         onfocusout="this.style.borderColor='#e2e8f0';this.style.boxShadow='none'">
                        <textarea placeholder="Write a comment…" rows="1"
                                  style="width:100%;resize:none;background:transparent;padding:8px 14px;border:none;outline:none;font-size:12px;color:#475569;font-family:inherit;line-height:1.5;"></textarea>
                    </div>
                    <button type="button"
                            style="padding:8px 16px;border-radius:10px;font-size:12px;font-weight:800;color:#fff;border:none;cursor:pointer;flex-shrink:0;font-family:inherit;background:linear-gradient(135deg,#6366f1,#8b5cf6);box-shadow:0 4px 12px rgba(99,102,241,.3);">
                        Send
                    </button>
                </div>
            </div>
            <!-- end post card -->

        </div>
        <!-- end main feed -->

        <!-- ═══ Right sidebar ═══ -->
        <div class="flex-1 lg:block hidden">
            <div class="sticky space-y-4" style="top:calc(var(--m-top) + 24px);">
                <div style="background:rgba(255,255,255,.85);backdrop-filter:blur(20px);border-radius:24px;border:1px solid rgba(255,255,255,.7);padding:20px;box-shadow:0 20px 60px rgba(99,102,241,.1);">
                    <partial name="Sidebar/_SuggestedFriends"></partial>
                </div>
            </div>
        </div>

    </div>
</main>

<partial name="Modals/_CreateStory"></partial>
<partial name="Modals/_CreateStatus"></partial>
