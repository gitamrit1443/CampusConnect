<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampusConnect</title>
    <link href="~/images/favicon.png" rel="icon" type="image/png" />
    <!-- Premium font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/App.styles.css" asp-append-version="true" />
    <style>
        /* ── Global font override ── */
        *, *::before, *::after {
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif !important;
        }

        /* ── Premium body background ── */
        body {
            background: linear-gradient(135deg, #eef2ff 0%, #f5f3ff 25%, #eff6ff 55%, #f0fdf4 100%);
            background-attachment: fixed;
        }

        /* ── Custom scrollbar ── */
        ::-webkit-scrollbar { width: 4px; height: 4px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #c7d2fe; border-radius: 99px; }
        ::-webkit-scrollbar-thumb:hover { background: #a5b4fc; }

        /* ── Gradient text utility ── */
        .text-gradient {
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #06b6d4 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* ── Card hover lift ── */
        .card-lift {
            transition: transform 0.25s cubic-bezier(.4,0,.2,1), box-shadow 0.25s cubic-bezier(.4,0,.2,1);
        }
        .card-lift:hover {
            transform: translateY(-2px);
            box-shadow: 0 24px 64px -12px rgba(99, 102, 241, 0.14);
        }

        /* ── Floating animated background orbs ── */
        @@keyframes orb-float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33%       { transform: translate(30px, -20px) scale(1.04); }
            66%       { transform: translate(-20px, 15px) scale(0.97); }
        }
        .orb { animation: orb-float var(--dur, 10s) ease-in-out infinite; }

        /* ── Gradient avatar ring ── */
        .avatar-ring {
            background: linear-gradient(135deg, #6366f1, #8b5cf6, #ec4899);
            padding: 2.5px;
            border-radius: 16px;
        }
        .avatar-ring > img, .avatar-ring > div {
            border-radius: 13px;
        }

        /* ── Premium modal backdrop ── */
        .uk-modal-dialog {
            border-radius: 1.75rem !important;
        }

        /* ── Sidebar scrollbar hide ── */
        #side::-webkit-scrollbar { width: 0; }

        /* ── Story hover ── */
        .story-item { transition: transform 0.2s ease, filter 0.2s ease; }
        .story-item:hover { transform: scale(1.09) rotate(-1deg); filter: brightness(1.05); }
    </style>
</head>
<body class="min-h-screen text-slate-900 antialiased">
    <div id="wrapper" class="relative min-h-screen overflow-x-hidden">
        <!-- Floating background orbs (pointer-events-none, z-below-everything) -->
        <div class="pointer-events-none fixed inset-0 overflow-hidden" style="z-index:-1">
            <div class="orb absolute -top-40 -left-32 w-[560px] h-[560px] rounded-full opacity-60 blur-3xl"
                 style="background:radial-gradient(circle, #c7d2fe 0%, #e0e7ff 60%, transparent 100%); --dur:12s;"></div>
            <div class="orb absolute top-1/3 -right-40 w-[480px] h-[480px] rounded-full opacity-50 blur-3xl"
                 style="background:radial-gradient(circle, #ddd6fe 0%, #ede9fe 60%, transparent 100%); --dur:15s; animation-delay:-5s;"></div>
            <div class="orb absolute -bottom-32 left-1/3 w-[400px] h-[400px] rounded-full opacity-40 blur-3xl"
                 style="background:radial-gradient(circle, #bfdbfe 0%, #dbeafe 60%, transparent 100%); --dur:18s; animation-delay:-9s;"></div>
        </div>

        <partial name="Navigation/_TopBar" />
        <partial name="Navigation/_SideBar" />
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/uikit.min.js"></script>
    <script src="~/js/simplebar.js"></script>
    <script src="~/js/script.js"></script>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
