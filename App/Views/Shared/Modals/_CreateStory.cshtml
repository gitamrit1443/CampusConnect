<div id="create-story" class="uk-modal" uk-modal="">
    <div class="uk-modal-dialog relative overflow-hidden mx-auto bg-white/97 backdrop-blur-2xl shadow-2xl border border-white/80 md:w-[540px] w-[94vw]"
         style="border-radius:1.75rem;">

        <!-- Modal header -->
        <div class="relative text-center px-7 py-5 border-b border-white/30"
             style="background:linear-gradient(135deg,#6366f1 0%,#8b5cf6 40%,#06b6d4 100%);">
            <div class="absolute top-0 left-0 w-40 h-40 rounded-full opacity-15 blur-3xl -translate-x-1/3 -translate-y-1/3"
                 style="background:#a5b4fc;"></div>
            <div class="absolute bottom-0 right-0 w-28 h-28 rounded-full opacity-15 blur-2xl translate-x-1/4 translate-y-1/3"
                 style="background:#67e8f9;"></div>

            <h2 class="text-base font-bold text-white relative z-10">Create Story</h2>
            <button type="button"
                    class="absolute top-1/2 right-4 -translate-y-1/2 w-9 h-9 rounded-full flex items-center justify-center text-white/80 hover:text-white hover:bg-white/20 duration-200 uk-modal-close z-10">
                <ion-icon name="close-outline" class="text-2xl"></ion-icon>
            </button>
        </div>

        <!-- Form body -->
        <form action="" method="post" enctype="multipart/form-data" class="p-6 sm:p-7 space-y-4">

            <!-- Dropzone -->
            <div class="w-full h-72 relative overflow-hidden rounded-2xl border-2 border-dashed group cursor-pointer duration-300 hover:border-indigo-400"
                 style="border-color:#c7d2fe; background:linear-gradient(135deg,#f5f3ff,#eef2ff,#eff6ff);">
                <label for="createStatusUrl"
                       class="flex flex-col items-center justify-center absolute inset-0 z-10 cursor-pointer gap-4">
                    <input id="createStatusUrl" name="uploadedContent" type="file"
                           accept="image/png,image/jpg,image/jpeg" class="hidden" />

                    <!-- Icon box -->
                    <div class="w-20 h-20 rounded-3xl bg-white shadow-xl border border-indigo-100 flex items-center justify-center text-indigo-500 group-hover:scale-105 duration-300 group-hover:shadow-2xl group-hover:shadow-indigo-200"
                         style="background:linear-gradient(135deg,#ffffff,#f5f3ff);">
                        <ion-icon name="cloud-upload-outline" class="text-4xl"></ion-icon>
                    </div>

                    <div class="text-center px-4">
                        <p class="text-slate-900 font-bold text-base">Drop your image here</p>
                        <p class="text-slate-400 text-sm mt-1">PNG, JPG or JPEG supported</p>
                    </div>

                    <span class="inline-flex items-center gap-2 rounded-full text-white text-sm font-bold px-5 py-2.5 shadow-lg shadow-indigo-200 duration-200 hover:opacity-90"
                          style="background:linear-gradient(135deg,#6366f1,#8b5cf6);">
                        <ion-icon name="image-outline" class="text-base"></ion-icon>
                        Browse image
                    </span>
                </label>
            </div>

            <!-- Caption input -->
            <div class="relative">
                <input type="text" name="caption" placeholder="Add a caption (optional)…"
                       class="w-full rounded-2xl !bg-slate-50 !border-slate-200 focus:!border-indigo-400 focus:!ring-4 focus:!ring-indigo-100 !text-slate-900 !font-normal !text-sm !px-4 !py-3 !pl-10 duration-200" />
                <ion-icon name="chatbubble-outline" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-base pointer-events-none"></ion-icon>
            </div>

            <!-- Footer row -->
            <div class="flex sm:flex-row flex-col sm:items-center sm:justify-between gap-3 rounded-2xl bg-gradient-to-r p-4 border border-indigo-100/50"
                 style="background:linear-gradient(135deg,#eef2ff,#ede9fe);">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl flex items-center justify-center shrink-0 text-indigo-600 border border-indigo-100"
                         style="background:linear-gradient(135deg,#ffffff,#f5f3ff);">
                        <ion-icon name="time-outline" class="text-xl"></ion-icon>
                    </div>
                    <p class="text-sm text-slate-600 font-medium leading-5">
                        Visible for <span class="text-slate-900 font-bold">24 hours</span><br />
                        <span class="text-xs text-slate-400">then automatically removed</span>
                    </p>
                </div>
                <button type="submit"
                        class="sm:w-auto w-full rounded-2xl text-white px-8 py-2.5 font-bold text-sm shadow-lg shadow-indigo-200/70 duration-200 hover:opacity-90 hover:scale-[1.02]"
                        style="background:linear-gradient(135deg,#6366f1,#8b5cf6,#7c3aed);">
                    Share Story
                </button>
            </div>
        </form>

    </div>
</div>
