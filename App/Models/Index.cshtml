<main id="site__main" class="relative overflow-hidden 2xl:ml-[--w-side] xl:ml-[--w-side-sm] min-h-[calc(100vh-var(--m-top))] mt-[--m-top] bg-gradient-to-br from-slate-100 via-blue-50 to-indigo-100 px-4 py-8 sm:px-6">
    <div class="pointer-events-none absolute -top-32 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-blue-300/30 blur-3xl"></div>
    <div class="pointer-events-none absolute top-40 right-10 h-72 w-72 rounded-full bg-indigo-300/20 blur-3xl"></div>

    <div class="relative lg:flex 2xl:gap-16 gap-10 max-w-[1160px] mx-auto" id="js-oversized">
        <div class="max-w-[700px] w-full mx-auto space-y-6">
            <div class="rounded-[2rem] bg-white/85 backdrop-blur-xl border border-white/80 shadow-xl shadow-slate-200/70 px-5 py-5 overflow-hidden">
                <div class="flex items-center justify-between gap-3">
                    <div>
                        <div class="inline-flex items-center gap-2 rounded-full bg-blue-50 text-blue-600 px-3 py-1 text-xs font-semibold mb-2">
                            <ion-icon name="sparkles-outline" class="text-base"></ion-icon>
                            Fresh moments
                        </div>
                        <h3 class="font-extrabold text-2xl text-slate-950 tracking-tight">Stories</h3>
                        <p class="text-sm text-slate-500 mt-1">Share a moment with your campus friends</p>
                    </div>
                    <button type="button" class="hidden sm:flex items-center gap-2 rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white px-4 py-2.5 text-sm font-semibold shadow-lg shadow-blue-200 duration-200" uk-toggle="target: #create-story">
                        <ion-icon name="add-outline" class="text-xl"></ion-icon>
                        <span>Create</span>
                    </button>
                </div>

                <div class="relative mt-5" tabindex="-1" uk-slider="autoplay: true; finite: true" uk-lightbox="">
                    <div class="uk-slider-container">
                        <ul class="uk-slider-items w-[calc(100%+14px)]" uk-scrollspy="target: >li; cls: uk-animation-scale-up; delay: 20; repeat: true">
                            <li class="md:pr-3 pr-2" uk-scrollspy-class="uk-animation-fade">
                                <button type="button" class="md:w-16 md:h-16 w-14 h-14 rounded-2xl relative border-2 border-dashed border-blue-500 grid place-items-center bg-blue-50 text-blue-600 shadow-sm shrink-0 hover:bg-blue-100 hover:scale-105 duration-300" uk-toggle="target: #create-story">
                                    <ion-icon name="camera-outline" class="text-2xl"></ion-icon>
                                </button>
                            </li>
                            <li class="md:pr-3 pr-2 hover:scale-[1.08] duration-300">
                                <a href="~/images/avatar/default-avatar.png" class="block">
                                    <div class="md:w-16 md:h-16 w-14 h-14 relative md:border-4 border-2 shadow border-white rounded-2xl overflow-hidden bg-slate-100 ring-2 ring-blue-500/40">
                                        <img src="~/images/avatar/user.png" class="w-full h-full object-cover" alt="story" />
                                    </div>
                                </a>
                            </li>
                            <li class="md:pr-3 pr-2 hover:scale-[1.08] duration-300">
                                <a href="~/images/avatar/default-avatar.png" class="block">
                                    <div class="md:w-16 md:h-16 w-14 h-14 relative md:border-4 border-2 shadow border-white rounded-2xl overflow-hidden bg-slate-100 ring-2 ring-indigo-500/40">
                                        <img src="~/images/avatar/user.png" class="w-full h-full object-cover" alt="story" />
                                    </div>
                                </a>
                            </li>
                            <li class="md:pr-3 pr-2">
                                <div class="md:w-16 md:h-16 w-14 h-14 bg-white/70 rounded-2xl animate-pulse border border-slate-200"></div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="md:max-w-[600px] mx-auto flex-1 xl:space-y-6 space-y-4">
                <div class="bg-white/90 backdrop-blur-xl rounded-[1.75rem] shadow-xl shadow-slate-200/60 p-4 space-y-4 text-sm font-medium border border-white/80">
                    <div class="flex items-center md:gap-3 gap-2">
                        <div class="w-11 h-11 shrink-0 rounded-2xl overflow-hidden ring-2 ring-white shadow-sm bg-slate-100">
                            <img src="~/images/avatar/user.png" alt="user" class="w-full h-full object-cover" />
                        </div>
                        <button type="button" class="flex-1 min-w-0 bg-slate-50 hover:bg-blue-50 transition-all rounded-2xl cursor-pointer text-slate-500 text-left px-4 py-3 border border-slate-100 hover:border-blue-100" uk-toggle="target: #create-status">
                            What do you have in mind?
                        </button>
                        <button type="button" class="w-11 h-11 shrink-0 rounded-2xl transition-all bg-pink-50 hover:bg-pink-100 text-pink-600 flex items-center justify-center border border-pink-100" uk-toggle="target: #create-status">
                            <ion-icon name="image-outline" class="text-2xl"></ion-icon>
                        </button>
                    </div>
                </div>

                <div class="bg-white/85 backdrop-blur-xl rounded-[1.75rem] shadow-lg shadow-slate-200/50 md:p-5 p-4 text-sm font-medium border border-white/80 text-slate-600 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                        <ion-icon name="newspaper-outline" class="text-xl"></ion-icon>
                    </div>
                    <div>
                        <h4 class="text-slate-950 font-semibold">No posts available yet</h4>
                        <p class="text-slate-500 mt-0.5">Would you like to create the first one?</p>
                    </div>
                </div>

                <div class="bg-white/90 backdrop-blur-xl rounded-[1.75rem] shadow-xl shadow-slate-200/60 text-sm font-medium border border-white/80 overflow-hidden">
                    <div class="flex gap-3 sm:p-5 p-4 text-sm font-medium">
                        <a href="" class="shrink-0">
                            <img src="~/images/avatar/user.png" alt="posts" class="w-11 h-11 rounded-2xl object-cover ring-2 ring-white shadow-sm" />
                        </a>
                        <div class="flex-1 min-w-0">
                            <a href="" class="text-decoration-none">
                                <h4 class="text-slate-950 font-semibold leading-5">Marccoa Pop</h4>
                                <div class="text-xs text-slate-500 mt-0.5 flex items-center gap-1">
                                    <ion-icon name="time-outline" class="text-sm"></ion-icon>
                                    1 day ago
                                </div>
                            </a>
                        </div>
                        <div class="relative -mr-1">
                            <button type="button" class="button-icon w-9 h-9 flex items-center justify-center rounded-2xl hover:bg-slate-100 text-slate-600 duration-200">
                                <ion-icon class="text-xl" name="ellipsis-horizontal"></ion-icon>
                            </button>
                            <div class="w-[245px] rounded-2xl bg-white/95 backdrop-blur-xl shadow-xl border border-white/80 p-2" uk-dropdown="pos: bottom-right; animation: uk-animation-scale-up; animate-out: true; mode: click">
                                <form>
                                    <button type="submit" class="icon-link w-full flex items-center gap-2 rounded-xl px-3 py-2 hover:!bg-red-50">
                                        <ion-icon class="text-xl shrink-0" name="flag-outline"></ion-icon>
                                        <span>Report</span>
                                    </button>
                                </form>
                                <hr class="my-1" />
                                <form>
                                    <button type="submit" class="icon-link w-full flex items-center gap-2 rounded-xl px-3 py-2 hover:!bg-blue-50">
                                        <ion-icon class="text-xl shrink-0" name="lock-closed-outline"></ion-icon>
                                        <span>Set as private</span>
                                    </button>
                                </form>
                                <hr class="my-1" />
                                <form>
                                    <button type="submit" class="icon-link w-full flex items-center gap-2 rounded-xl px-3 py-2 hover:!bg-red-50 text-red-600">
                                        <ion-icon class="text-xl shrink-0" name="trash-bin-outline"></ion-icon>
                                        <span>Delete Post</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <a href="" class="block text-decoration-none text-slate-700">
                        <div class="sm:px-5 p-4 pt-0 w-full">
                            <p class="font-normal leading-6">
                                This is our first status from the #campus connect app where you can share text or pictures with your friends...
                            </p>
                        </div>
                    </a>

                    <a href="" class="block">
                        <div class="relative w-full lg:h-96 h-72 sm:px-5 px-4">
                            <img src="https://gulfseagrant.org/wp-content/uploads/2022/10/Placeholder_view_vector.jpg" alt="image-post" class="rounded-[1.5rem] w-full h-full object-cover shadow-sm" />
                        </div>
                    </a>

                    <div class="sm:p-5 p-4 flex items-center gap-5 text-xs font-semibold text-slate-600">
                        <div class="flex items-center gap-2.5">
                            <a href="" class="button-icon text-red-500 bg-red-50 w-10 h-10 rounded-2xl flex items-center justify-center hover:bg-red-100 duration-200">
                                <ion-icon class="text-lg" name="heart"></ion-icon>
                            </a>
                            <a href="" class="text-slate-700 text-decoration-none">24</a>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <a href="" class="button-icon w-10 h-10 rounded-2xl flex items-center justify-center bg-blue-50 text-blue-600 hover:bg-blue-100 duration-200">
                                <ion-icon class="text-lg" name="chatbubble-ellipses-outline"></ion-icon>
                            </a>
                            <a href="#" class="text-slate-700 text-decoration-none">5</a>
                        </div>
                        <div class="ml-auto">
                            <a href="" class="button-icon w-10 h-10 rounded-2xl flex items-center justify-center bg-slate-100 text-slate-600 hover:bg-slate-200 duration-200">
                                <ion-icon class="text-lg" name="bookmark-outline"></ion-icon>
                            </a>
                        </div>
                    </div>

                    <div class="sm:px-5 sm:py-4 p-4 border-t border-slate-100 flex items-center gap-2 bg-slate-50/70">
                        <img src="~/images/avatar/user.png" alt="comment-section" class="w-9 h-9 rounded-2xl object-cover ring-2 ring-white shadow-sm" />
                        <div class="flex-1 relative overflow-hidden min-h-10 bg-white border border-slate-200 rounded-2xl">
                            <textarea name="" id="" placeholder="Add Comment..." rows="1" class="w-full resize-none !bg-transparent px-4 py-2 focus:!border-transparent focus:!ring-transparent text-sm"></textarea>
                        </div>
                        <button type="button" class="text-sm rounded-2xl py-2.5 px-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold shadow-sm duration-200">Comment</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-1 lg:block hidden">
            <div class="sticky top-[calc(var(--m-top)+24px)] space-y-4">
                <div class="bg-white/85 backdrop-blur-xl rounded-[1.75rem] border border-white/80 shadow-xl shadow-slate-200/60 p-5">
                    <partial name="Sidebar/_SuggestedFriends"></partial>
                </div>
            </div>
        </div>
    </div>
</main>

<partial name="Modals/_CreateStory"></partial>
<partial name="Modals/_CreateStatus"></partial>
